{
  "manifest_version": 3,
  "name": "Plastic Detox Product Check",
  "version": "1.3.0",
  "description": "Our researched verdict on Amazon listings: formula, packaging, recalls and lawsuits, independent tests.",
  "homepage_url": "https://plasticdetox.org/brand-check.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://plasticdetox-quiz-email.plasticdetox.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://plasticdetox.org/vet.html*",
        "https://www.plasticdetox.org/vet.html*"
      ],
      "js": [
        "src/pass-capture.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Plastic Detox Product Check"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "data/*.json"
      ],
      "matches": [
        "https://www.amazon.com/*"
      ]
    }
  ]
}
