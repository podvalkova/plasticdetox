    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.0",
    "@capgo/capacitor-updater": "^8.51.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
