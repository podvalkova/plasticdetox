{
  "appId": "org.plasticdetox.app",
  "appName": "Plastic Detox",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#EAE8E1"
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": "onLaunch",
      "updateUrl": "https://plasticdetox-quiz-email.plasticdetox.workers.dev/app-update",
      "directUpdate": false,
      "resetWhenUpdate": true,
      "appReadyTimeout": 20000
    }
  },
  "android": {
    "backgroundColor": "#EAE8E1",
    "allowMixedContent": false,
    "captureInput": true,
    "includePlugins": [
      "@capacitor-community/in-app-review",
      "@capacitor/app",
      "@capacitor/browser",
      "@capacitor/filesystem",
      "@capacitor/haptics",
      "@capacitor/local-notifications",
      "@capacitor/preferences",
      "@capacitor/share",
      "@capgo/capacitor-updater",
      "@capgo/native-purchases"
    ]
  }
}
